50 3 * * 1-5 /home/ec2-user/dev-sandbox/run_fno_daily.sh --profile vishal >> /home/ec2-user/dev-sandbox/logs/cron_fno_vishal.log 2>&1

# === Reconciliation (3:40 PM IST = 10:10 UTC) ===
